# Copia este archivo como .env para desarrollo local.
# Nunca subas .env con valores reales al repositorio.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Opcionales: personalizan la plantilla para una empresa nueva.
# Nombre mostrado en la pantalla de login (antes de tener sesión activa;
# después del login se usa la razón social de "Configuración > Empresa").
VITE_APP_NAME=
# Locale para formatear fechas y números. Default: es-CL.
VITE_APP_LOCALE=
# Símbolo usado al mostrar montos. Default: $.
VITE_APP_MONEDA_SIMBOLO=
# Nombre del bucket de Storage, si no quieres usar el de default.
VITE_STORAGE_BUCKET_ASSETS=
